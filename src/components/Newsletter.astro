---
// Visual-only signup — this is a static demo template with no backend, so
// the form just prevents default submission and shows a friendly message.
---

<section class="newsletter container">
	<div class="newsletter-inner">
		<h2>Stay in the loop</h2>
		<p>New arrivals, restocks and the occasional discount — no spam, unsubscribe any time.</p>

		<form class="newsletter-form" id="newsletter-form">
			<input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
			<button type="submit">Subscribe</button>
		</form>
		<p class="newsletter-success" id="newsletter-success" hidden>Thanks! You're on the list.</p>
	</div>
</section>

<style>
	.newsletter {
		padding-block: clamp(60px, 8vw, 100px);
		border-top: 1px solid var(--color-line);
	}

	.newsletter-inner {
		max-width: 560px;
		margin-inline: auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.newsletter-inner h2 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(26px, 3.4vw, 36px);
		margin: 0;
	}

	.newsletter-inner p {
		color: var(--color-ink-soft);
		line-height: 1.6;
		margin: 0 0 14px;
	}

	.newsletter-form {
		display: flex;
		width: 100%;
		gap: 12px;
		border-bottom: 1px solid var(--color-ink);
		padding-bottom: 10px;
	}

	.newsletter-form input {
		flex: 1;
		border: none;
		background: transparent;
		font-family: var(--font-sans);
		font-size: 15px;
		padding: 8px 0;
		color: var(--color-ink);
	}

	.newsletter-form input:focus {
		outline: none;
	}

	.newsletter-form button {
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
		padding: 8px 4px;
		transition: opacity 0.2s;
	}

	.newsletter-form button:hover {
		opacity: 0.6;
	}

	.newsletter-success {
		font-size: 13px;
		color: var(--color-ink-soft);
	}
</style>

<script>
	function initNewsletterForm() {
		const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
		const success = document.getElementById('newsletter-success');

		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			form.hidden = true;
			success?.removeAttribute('hidden');
		});
	}
	initNewsletterForm();
</script>
