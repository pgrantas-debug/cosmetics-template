---
// Hero.astro
// hero.png already has the "LUMÉ" wordmark composited into the photo itself
// (same approach as the reference site), so no extra headline text is drawn
// on top of the image — that would just duplicate it. All copy (eyebrow, CTA,
// quick links) lives in the clean space below the photo instead.
---

<section class="hero">
	<div class="hero-media">
		<picture>
			<source media="(max-width: 640px)" srcset="/images/mobilehero.png" width="1350" height="1690" />
			<img src="/images/hero.png" alt="LUMÉ — thoughtfully chosen beauty" width="1920" height="1080" fetchpriority="high" />
		</picture>

		<a href="#featured" class="scroll-cue" aria-label="Scroll down">
			<span class="scroll-line"></span>
			<span>Scroll</span>
		</a>
	</div>

	<div class="hero-body container">
		<p class="eyebrow hero-eyebrow">Curated Skincare &amp; Beauty</p>

		<div class="hero-actions">
			<a href="/shop" class="cta">
				<span>Discover the collection</span>
				<svg width="15" height="10" viewBox="0 0 15 10" fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M0 5h13M9 1l4 4-4 4" />
				</svg>
			</a>

			<nav class="quick-links" aria-label="Quick category links">
				<a href="/shop?category=plauku-prieziuros-priemones">Hair</a>
				<a href="/shop?category=kuno-prieziura">Body</a>
				<a href="/shop?category=veido-prieziura">Face</a>
				<a href="/shop">Everything</a>
			</nav>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--color-bg);
	}

	/* Photo shown at full width, natural ratio, no cropping — the fixed
	   header floats above it with no background, so nothing draws a hard
	   line between the header and the hero. */
	.hero-media {
		position: relative;
		width: 100%;
		line-height: 0;
	}

	.hero-media img {
		width: 100%;
		height: auto;
		display: block;
	}

	/* Soft fade from the bottom of the photo into the page background —
	   without it there'd be a hard edge between the greyish photo and the
	   ivory page background. */
	.hero-media::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 14%;
		background: linear-gradient(to bottom, transparent, var(--color-bg));
		pointer-events: none;
	}

	.hero-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 22px;
		padding-block: clamp(20px, 3vw, 32px) clamp(32px, 5vw, 56px);
	}

	.hero-eyebrow {
		max-width: 30ch;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(20px, 3vw, 30px);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 34px;
		border: 1px solid var(--color-ink);
		border-radius: 999px;
		font-size: 13px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.cta svg {
		transition: transform 0.3s var(--ease);
	}

	.cta:hover {
		background: var(--color-ink);
		color: var(--color-bg);
	}

	.cta:hover svg {
		transform: translateX(3px);
	}

	.quick-links {
		display: flex;
		align-items: center;
		gap: clamp(14px, 2.4vw, 26px);
		flex-wrap: wrap;
		justify-content: center;
	}

	.quick-links a {
		position: relative;
		font-size: 12.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
		padding-bottom: 3px;
		transition: color 0.2s;
	}

	.quick-links a:not(:last-child)::after {
		content: '';
		position: absolute;
		right: calc(-1 * clamp(7px, 1.2vw, 13px));
		top: 50%;
		transform: translateY(-50%);
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-line-strong);
	}

	.quick-links a:hover {
		color: var(--color-ink);
	}

	.scroll-cue {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		font-size: 10px;
		letter-spacing: 0.2em;
		color: var(--color-ink-soft);
		opacity: 0.7;
	}

	.scroll-line {
		width: 1px;
		height: 26px;
		background: var(--color-line-strong);
		overflow: hidden;
		position: relative;
	}

	.scroll-line::after {
		content: '';
		position: absolute;
		top: -100%;
		left: 0;
		width: 100%;
		height: 100%;
		background: var(--color-ink);
		animation: scroll-drip 1.8s ease-in-out infinite;
	}

	@keyframes scroll-drip {
		0% {
			top: -100%;
		}
		60%,
		100% {
			top: 100%;
		}
	}

	@media (max-width: 640px) {
		.scroll-cue {
			display: none;
		}
	}
</style>
