---
import { CATEGORY_LABELS } from '../data/categories';

const year = new Date().getFullYear();
const topCategories = Object.entries(CATEGORY_LABELS).slice(0, 5);
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<span class="wordmark">LUMÉ</span>
			<p>Curated skincare, makeup and beauty essentials — thoughtfully sourced, simply presented.</p>
		</div>

		<div class="footer-col footer-col-categories">
			<span class="footer-heading">Categories</span>
			{topCategories.map(([slug, label]) => <a href={`/shop?category=${slug}`}>{label}</a>)}
		</div>

		<div class="footer-col">
			<span class="footer-heading">LUMÉ</span>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
			<a href="/cart">Cart</a>
		</div>

		<div class="footer-col">
			<span class="footer-heading">Get in touch</span>
			<a href="mailto:hello@lumecosmetics.com">hello@lumecosmetics.com</a>
			<div class="footer-social">
				<span>Instagram</span>
				<span>Facebook</span>
			</div>
		</div>
	</div>

	<div class="container footer-bottom">
		<span>© {year} LUMÉ. This is a demo template — all rights reserved to its design.</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		background: var(--color-bg);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 40px;
		padding-block: clamp(50px, 6vw, 80px);
	}

	.footer-brand .wordmark {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 24px;
		letter-spacing: 0.06em;
		margin-bottom: 16px;
	}

	.footer-brand p {
		color: var(--color-ink-soft);
		font-size: 13.5px;
		line-height: 1.6;
		max-width: 32ch;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-heading {
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
		margin-bottom: 4px;
	}

	.footer-col a {
		font-size: 14px;
		color: var(--color-ink);
		transition: opacity 0.2s;
	}

	.footer-col a:hover {
		opacity: 0.6;
	}

	.footer-social {
		display: flex;
		gap: 14px;
		margin-top: 4px;
		font-size: 14px;
		color: var(--color-ink-soft);
	}

	.footer-bottom {
		border-top: 1px solid var(--color-line);
		padding-block: 22px;
		font-size: 12px;
		color: var(--color-ink-soft);
	}

	@media (max-width: 800px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 28px 20px;
			padding-block: 36px 28px;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}

		.footer-brand p {
			max-width: 46ch;
		}

		.footer-col-categories {
			display: none;
		}

		.footer-col {
			gap: 10px;
		}

		.footer-bottom {
			padding-block: 16px;
			font-size: 11.5px;
			text-align: center;
		}
	}
</style>
