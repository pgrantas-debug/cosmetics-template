	{
		name: 'Facebook',
		href: '#',
		color: '#1877f2',
		path: 'M14.5 22v-8.4h2.82l.42-3.27h-3.24V8.24c0-.95.26-1.59 1.62-1.59h1.73V3.73C17.55 3.68 16.56 3.6 15.4 3.6c-2.42 0-4.08 1.48-4.08 4.19v2.54H8.5v3.27h2.82V22h3.18Z',
