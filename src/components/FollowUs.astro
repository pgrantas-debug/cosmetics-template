---

<section class="follow">
	<div class="container follow-inner">
		<p class="eyebrow">@lumecosmetics</p>
		<h2>Follow along</h2>
		<p class="follow-lead">Behind-the-scenes, new arrivals and restock alerts — find us on your platform of choice.</p>

		<div class="follow-socials">
			{socials.map((s) => (
				<a href={s.href} class="follow-social" style={`--brand: ${s.color}`} aria-label={s.name} target="_blank" rel="noopener">
					<svg width="56" height="56" viewBox="0 0 24 24" fill="currentColor">
						<path d={s.path} />
					</svg>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.follow {
		border-top: 1px solid var(--color-line);
		background: var(--color-bg-alt);
	}

	.follow-inner {
		padding-block: clamp(50px, 7vw, 84px);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
	}

	.follow-inner h2 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(26px, 3.4vw, 38px);
		margin: 0;
	}

	.follow-lead {
		color: var(--color-ink-soft);
		line-height: 1.6;
		max-width: 42ch;
	}

	.follow-socials {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: clamp(20px, 3.4vw, 34px);
		margin-top: 24px;
	}

	.follow-social {
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(64px, 6vw, 84px);
		height: clamp(64px, 6vw, 84px);
		border-radius: 50%;
		color: var(--color-ink);
		background: var(--color-bg);
		box-shadow:
			0 10px 24px rgba(26, 24, 22, 0.07),
			0 2px 6px rgba(26, 24, 22, 0.05),
			inset 0 0 0 1px var(--color-line);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease), transform 0.3s var(--ease),
			box-shadow 0.3s var(--ease);
	}

	.follow-social svg {
		width: clamp(24px, 2.2vw, 32px);
		height: clamp(24px, 2.2vw, 32px);
		transition: transform 0.3s var(--ease);
	}

	.follow-social:hover {
		background: var(--brand);
		color: #fff;
		transform: translateY(-4px) scale(1.04);
		box-shadow:
			0 16px 28px -6px color-mix(in srgb, var(--brand) 45%, transparent),
			inset 0 0 0 1px transparent;
	}

	.follow-social:hover svg {
		transform: scale(1.08);
	}

	@media (max-width: 560px) {
		.follow-social {
			width: 60px;
			height: 60px;
		}

		.follow-social svg {
			width: 24px;
			height: 24px;
		}
	}
</style>
