---
// Generic "follow us" visual placeholder — a small grid of product photos
// from the catalog, no real social links (this is a fictional brand).
import { products } from '../data/products';

const featured = products.slice(0, 4);
---

<section class="follow">
	<div class="container follow-inner">
		<p class="eyebrow">@lumecosmetics</p>
		<h2>Follow along</h2>
		<div class="follow-grid">
			{featured.map((p) => (
				<div class="follow-tile">
					<img src={p.image} alt={p.name} loading="lazy" width="300" height="300" />
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.follow {
		border-top: 1px solid var(--color-line);
		background: var(--color-bg-alt);
	}

	.follow-inner {
		padding-block: clamp(50px, 7vw, 84px);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
	}

	.follow-inner h2 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(26px, 3.4vw, 38px);
		margin: 0;
	}

	.follow-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
		width: 100%;
		max-width: 640px;
		margin-top: 20px;
	}

	.follow-tile {
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.follow-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s var(--ease);
	}

	.follow-tile:hover img {
		transform: scale(1.06);
	}

	@media (max-width: 560px) {
		.follow-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 8px;
		}
	}
</style>
