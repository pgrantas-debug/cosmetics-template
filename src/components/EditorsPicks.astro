---
import ProductCard from './ProductCard.astro';
import { products } from '../data/products';

const picks = products.filter((p) => p.tags.includes('featured') && p.stockStatus !== 'out_of_stock').slice(0, 8);
---

{picks.length > 0 ? (
	<section class="editors-picks container">
		<div class="editors-picks-head">
			<p class="eyebrow">Curated by us</p>
			<h2>Editor's Picks</h2>
			<p class="editors-picks-lead">
				The pieces our team keeps reaching for — a running list of what earns its spot in the
				collection, updated as we test and re-test.
			</p>
		</div>

		<div class="editors-picks-grid">
			{picks.map((p) => (
				<ProductCard
					name={p.name}
					brand={p.brand}
					price={p.price}
					oldPrice={p.oldPrice}
					discount={p.discount}
					image={p.image}
					slug={p.slug}
					categoryLabel={p.categoryLabel}
					tags={p.tags}
					stockQty={p.stockQty}
					stockStatus={p.stockStatus}
				/>
			))}
		</div>

		<div class="editors-picks-cta">
			<a href="/shop?featured=1" class="see-all-btn">View all picks</a>
		</div>
	</section>
) : null}

<style>
	.editors-picks {
		padding-block: clamp(60px, 8vw, 110px);
	}

	.editors-picks-head {
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 56ch;
		margin-bottom: clamp(28px, 4vw, 40px);
	}

	.editors-picks-head h2 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(28px, 3.6vw, 44px);
		margin: 0;
	}

	.editors-picks-lead {
		color: var(--color-ink-soft);
		line-height: 1.6;
	}

	.editors-picks-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(20px, 2.4vw, 36px);
	}

	.editors-picks-cta {
		display: flex;
		justify-content: center;
		margin-top: clamp(36px, 5vw, 56px);
	}

	.see-all-btn {
		padding: 15px 38px;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink);
		transition: all 0.2s var(--ease);
	}

	.see-all-btn:hover {
		background: var(--color-ink);
		border-color: var(--color-ink);
		color: var(--color-bg);
	}

	@media (max-width: 1024px) {
		.editors-picks-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 720px) {
		.editors-picks-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 16px;
		}
	}
</style>
