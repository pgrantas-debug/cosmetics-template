---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import BrandStrip from '../components/BrandStrip.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import EditorsPicks from '../components/EditorsPicks.astro';
import FollowUs from '../components/FollowUs.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout
	title="LUMÉ — Curated Skincare & Beauty"
	description="LUMÉ is a curated cosmetics e-shop template — skincare, makeup, hair care and fragrance from independent labs we trust."
>
	<Hero />
	<ProductGrid />
	<BrandStrip />
	<AboutTeaser />
	<EditorsPicks />
	<FollowUs />
	<Newsletter />
</BaseLayout>
